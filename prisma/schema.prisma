generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  phone        String        @unique
  password     String?
  role         String        @default("user")
  geminiApiKey String?
  customPrompt String        @default("해당 상품명에 대해 리뷰작성해주는데\n들어가야 하는 요소는 구매이유, 실제 사용해보니 좋은점\n글자수는 200자 내외로\n일반인이 실제 구매한 말투로 자연스럽게 그리고 줄바꿈은하지말고\n\n그리고 해당 제품에대해 리뷰를 3개를 써주면되는데 3개가 다 다른스타일이어야해 다 다른사람이 쓴것처럼해줘\n\n첫번째리뷰 : 위에 기본 프롬프트는 유지하면서 ㅋㅋ, ㅎㅎ, ^^,~ 이런 이모티콘 적절히 섞어서\n\n두번째리뷰 : 위에 기본 프롬프트는 유지하면서 깔끔하고 단백한 말투로\n\n세번째리뷰 : 위에 기본 프롬프트는 유지하면서 가족들위해 구매했다는 식으로 써줘")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  purchases    Purchase[]
  accountInfos AccountInfo[]
  sellerInfos  SellerInfo[]

  @@unique([name, phone])
}

model Purchase {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseDate     String
  
  accountHolder    String   @default("")
  
  productName      String
  chatRoomName     String
  platform         String   @default("쿠팡")
  price            Int
  reviewType       String
  paybackName      String
  contactOnBangpok String
  isReviewWritten  Boolean  @default(false)
  isProductPayback Boolean  @default(false)
  isReviewPayback  Boolean  @default(false)
  generatedReview  String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  photos           ReviewPhoto[]

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, purchaseDate(sort: Desc)])
}

// 리뷰 자동등록 시 함께 첨부할 판매자 제공 사진 (브라우저에서 초경량 JPEG 압축 후 임시 저장)
// 쿠팡 자동등록 성공 또는 [작성] 체크 시 즉시 삭제되어 DB 용량을 항상 최소로 유지합니다.
model ReviewPhoto {
  id         String   @id @default(uuid())
  userId     String
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  dataUrl    String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@index([userId])
}

model AccountInfo {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        String   @default("쿠팡")
  accountHolder   String   // 계정주 (목록에 표시될 대표 이름)
  recipient1      String   @default("")
  recipient2      String   @default("")
  recipient3      String   @default("")
  loginId         String   @default("")
  phoneNumber     String   @default("")
  address1        String   @default("")
  address2        String   @default("")
  address3        String   @default("")
  paybackAccount1 String   @default("")
  paybackAccount2 String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model SellerInfo {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String   @default("") // 업체명
  submissionForm String   @default("") // 제출 양식 (긴 텍스트)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}
